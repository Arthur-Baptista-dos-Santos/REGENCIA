# Copie para .env e preencha. NUNCA comite o arquivo .env verdadeiro.

# Chave que o jogo envia no header X-API-Key (obrigatoria, minimo 8 caracteres).
# Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Provedor de IA generativa: ollama (modelo local, padrao), openai (qualquer API compativel) ou simulado (sem IA, so para testes).
PROVEDOR=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b

# Servico compativel com a API de chat da OpenAI (usado quando PROVEDOR=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

# Origens autorizadas pelo CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,https://arthur-baptista-dos-santos.github.io

# Limites
TIMEOUT_S=45
MAX_PROMPT_CHARS=8000
LIMITE_REQUISICOES_POR_MINUTO=30
